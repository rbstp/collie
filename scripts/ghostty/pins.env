# libghostty-vt and the Zig that builds it, for the app (build-xcframework.sh) and collied
# (build-collied.sh). CI keys its libghostty-vt caches on this file.
#
# The tarball SHA-256s are the ones in the release's SHA256SUMS, whose minisign signature was checked
# against the Ghostty release key in PACKAGING-LIBGHOSTTY.md when pinning. That key has been
# RWQlAjJC23149WL2sEpT/l0QKy7hMIFhYdQOFy0Z7z7PbneUgvlsnYcV (id F5787DDB42320225) through 1.0.1.

# Moving this pin means rerunning scripts/ghostty/nerd-font-constraints.py.
LIBGHOSTTY_VT_VERSION=1.0.1
# The vt-1.0.1 tag, which nerd-font-constraints.py reads Ghostty's font tables from.
GHOSTTY_COMMIT=108cacb17ed8990840cd14abfce43d8ed8503ca1
SOURCE_SHA256=333dfce97641ef9b536bb9e08907ad86abaaada50e8f7417b70d9284adef37aa
DEPS_SHA256=91a4e10960a52bf5bf4b15aa2a2cddaff8a89d6cd903d3055bda4fd17de3356d

# Ghostty's CI builds libghostty-vt 1.0.1 with Zig 0.17.0 (flake.nix at vt-1.0.1); this stays on the
# newer 0.17.1 it already used on purpose, since minimum_zig_version is 0.17.0.
# One SHA-256 per host the builds download Zig on, from ziglang.org/download/index.json, checked
# against the downloaded tarball.
ZIG_VERSION=0.17.1
ZIG_SHA256_AARCH64_MACOS=75f1bc7a1e9852f17ec9a0c1895f767c4ec56d46bc8a834920eece1d0359dd8d
ZIG_SHA256_X86_64_LINUX=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a

# License texts uucode's Zig package leaves out, at the commit the dependency tarball holds.
UUCODE_LICENSES=https://raw.githubusercontent.com/jacobsandlund/uucode/1fb73433bba5d93366c57f23ff2e9d7939746500/licenses
UUCODE_UNICODE_SHA256=1eda5a3b026870c737b22e8bcd4954338612c790db688242e003f41a4fa95175
UUCODE_HOEHRMANN_SHA256=de219cece932aad5a817bf763393d8d149d378a15d2ad5320e3331eac07626dd
