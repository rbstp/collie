+// tailscale_accept_with_addr is tailscale_accept that also writes the remote
+// "ip:port" of the accepted connection to addr_out, NUL-terminated. The address
+// is delivered in the same message as the connection fd.
+//
+// Returns:
+// 	0      - success
+// 	EBADF  - listener is not a valid tailscale
+// 	ERANGE - insufficient storage for addr_out (the connection is closed)
+// 	-1     - call tailscale_errmsg for details
+extern int tailscale_accept_with_addr(tailscale_listener listener, tailscale_conn* conn_out, char* addr_out, size_t addrlen);
+
+// tailscale_whois_json writes the JSON encoding of apitype.WhoIsResponse for
+// addr ("ip" or "ip:port") to *json_out as a NUL-terminated, malloc'd string,
+// using tsnet's in-memory LocalAPI. The caller must free() it.
+//
+// Returns:
+// 	0     - success, *json_out is set
+// 	EBADF - sd is not a valid tailscale
+// 	-1    - call tailscale_errmsg for details (*json_out is NULL)
+extern int tailscale_whois_json(tailscale sd, const char* addr, char** json_out);
