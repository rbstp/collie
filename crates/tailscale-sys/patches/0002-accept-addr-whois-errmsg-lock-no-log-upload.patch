+//export TsnetWhoIsJSON
+func TsnetWhoIsJSON(sd C.int, addr *C.char, jsonOut **C.char) C.int {
+	if jsonOut == nil {
+		panic("whois_json passed nil json_out")
+	}
+	*jsonOut = nil
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	lc, err := s.s.LocalClient()
+	if err != nil {
+		return s.recErr(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	who, err := lc.WhoIs(ctx, C.GoString(addr))
+	if err != nil {
+		return s.recErr(err)
+	}
+	b, err := json.Marshal(who)
+	if err != nil {
+		return s.recErr(err)
+	}
+	*jsonOut = C.CString(string(b))
+	return 0
+}
