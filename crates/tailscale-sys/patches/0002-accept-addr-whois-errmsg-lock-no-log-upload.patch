+//export TsnetAcceptWithAddr
+func TsnetAcceptWithAddr(listenerFd C.int, connOut *C.int, buf *C.char, buflen C.size_t) C.int {
+	if buf == nil || buflen == 0 {
+		panic("accept_with_addr passed nil buf or buflen of 0")
+	}
+	out := unsafe.Slice((*byte)(unsafe.Pointer(buf)), buflen)
+	out[0] = '\x00'
+	var rec [acceptRecordLen]byte
+	if rc := tsnetAccept(listenerFd, connOut, &rec); rc != 0 {
+		return rc
+	}
+	addr := rec[:]
+	if i := strings.IndexByte(string(addr), 0); i >= 0 {
+		addr = addr[:i]
+	}
+	if len(addr) >= len(out) {
+		syscall.Close(int(*connOut))
+		*connOut = -1
+		return C.ERANGE
+	}
+	n := copy(out, addr)
+	out[n] = '\x00'
+	return 0
+}
