+// tailscale_rebind re-binds the node's UDP sockets, pings its DERP
+// connections (reconnecting one that does not answer within 3 s), forgets
+// the peers' direct paths and re-discovers its endpoints. Nothing does this
+// after a resume on iOS, where netmon has no time-jump check: a NAT mapping
+// or DERP connection that died while the process was suspended otherwise
+// lasts until DERP's 120 s read deadline.
+//
+// Returns:
+// 	0     - success
+// 	EBADF - sd is not a valid tailscale
+// 	-1    - call tailscale_errmsg for details
+extern int tailscale_rebind(tailscale sd);
