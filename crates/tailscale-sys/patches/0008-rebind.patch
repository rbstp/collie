+//export TsnetRebind
+func TsnetRebind(sd C.int, defaultIf *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	if defaultIf != nil {
+		setDefaultRouteInterface(C.GoString(defaultIf))
+	}
+	if sys := s.s.Sys(); sys != nil {
+		if nm, ok := sys.NetMon.GetOK(); ok {
+			injectNetworkChange(nm)
+		}
+	}
+	lc, err := s.s.LocalClient()
+	if err != nil {
+		return s.recErr(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	for _, action := range []string{"rebind", "restun"} {
+		if err := lc.DebugAction(ctx, action); err != nil {
+			return s.recErr(err)
+		}
+	}
+	return 0
+}
