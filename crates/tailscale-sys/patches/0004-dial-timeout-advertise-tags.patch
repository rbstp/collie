+//export TsnetSetAdvertiseTags
+func TsnetSetAdvertiseTags(sd C.int, str *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	tags := C.GoString(str)
+	if tags == "" {
+		s.s.AdvertiseTags = nil
+	} else {
+		s.s.AdvertiseTags = strings.Split(tags, ",")
+	}
+	return 0
+}
