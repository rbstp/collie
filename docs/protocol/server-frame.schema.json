{
  "$defs": {
    "Agent": {
      "properties": {
        "context_left": {
          "description": "Percent of the context window left, from the same transcript.",
          "format": "uint8",
          "maximum": 100,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_activity_ms": {
          "description": "When the transcript last changed.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "last_line": {
          "description": "The latest line of the agent's reply, from its transcript on the machine.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "status_since_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "terminal_id",
        "workspace_id",
        "status",
        "status_since_ms"
      ],
      "type": "object"
    },
    "AgentKind": {
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "type": "string"
    },
    "AgentStatus": {
      "enum": [
        "idle",
        "working",
        "blocked",
        "done",
        "unknown"
      ],
      "type": "string"
    },
    "Approval": {
      "properties": {
        "accepts_input": {
          "default": false,
          "description": "Whether collied takes `agent.send_keys` and `agent.type_text` on this prompt: false for\nany prompt that grants a permission, and from a collied that predates the field.",
          "type": "boolean"
        },
        "agent_label": {
          "type": "string"
        },
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "choices": {
          "default": [],
          "description": "The menu on screen, in order, whenever collied could read one.",
          "items": {
            "$ref": "#/$defs/ApprovalChoice"
          },
          "type": "array"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "has_text_field": {
          "default": false,
          "description": "The menu has a free-text option that `agent.type_text` fills: a question's \"Type\nsomething.\" (with `accepts_input`), or a plan's \"Tell Claude what to change\", which\ntakes text but no keys (`accepts_input` false).",
          "type": "boolean"
        },
        "nonce": {
          "$ref": "#/$defs/Nonce"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "type": "array"
        },
        "snippet": {
          "type": "string"
        },
        "supports_note": {
          "default": false,
          "description": "`approval.decide` takes a `note` with `approve` and `deny`: the prompt shows \"Tab\nto amend\".",
          "type": "boolean"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PendingTool"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_label": {
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "terminal_id",
        "agent_label",
        "workspace_label",
        "snippet",
        "options",
        "nonce",
        "created_at_ms",
        "expires_at_ms"
      ],
      "type": "object"
    },
    "ApprovalChoice": {
      "description": "`index` is 0-based; `current` marks the option under the menu cursor.",
      "properties": {
        "current": {
          "type": "boolean"
        },
        "detail": {
          "description": "The lines under the option's first line: a question option's description, or the\nrest of a label that wrapped. Absent from a collied that predates the field, which\njoins them into `label`.",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "label",
        "current"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "ApprovalOutcome": {
      "oneOf": [
        {
          "description": "Keys were sent and the agent then left `blocked`.",
          "properties": {
            "by": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/Decision"
            },
            "outcome": {
              "const": "applied",
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "decision",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "Keys were sent but the agent was still `blocked` when collied stopped waiting.",
          "properties": {
            "by": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/Decision"
            },
            "outcome": {
              "const": "unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "decision",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "`applied` for a `choose` decision. Its own outcome, so an older app decodes it as\n`other` instead of failing on an unknown decision.",
          "properties": {
            "by": {
              "type": "string"
            },
            "choice": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "const": "chosen",
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "choice",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "`unconfirmed` for a `choose` decision.",
          "properties": {
            "by": {
              "type": "string"
            },
            "choice": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "const": "chosen_unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "choice",
            "by"
          ],
          "type": "object"
        },
        {
          "properties": {
            "outcome": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "The prompt changed, or was answered on the Mac, before a decision was applied.",
          "properties": {
            "outcome": {
              "const": "superseded",
              "type": "string"
            }
          },
          "required": [
            "outcome"
          ],
          "type": "object"
        },
        {
          "properties": {
            "outcome": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "outcome"
          ],
          "type": "object"
        }
      ]
    },
    "Cwd": {
      "maxLength": 1024,
      "pattern": "^/",
      "type": "string"
    },
    "Decision": {
      "oneOf": [
        {
          "enum": [
            "approve",
            "approve_always",
            "deny"
          ],
          "type": "string"
        },
        {
          "const": "choose",
          "description": "Pick `Approval.choices[choice]`; only on an approval that offers no other decision.",
          "type": "string"
        }
      ]
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "draft": {
          "description": "With `draft_changed`: the text now in the Mac's input box.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "malformed_frame",
        "frame_too_large",
        "unknown_method",
        "invalid_params",
        "unsupported_protocol",
        "hello_required",
        "not_paired",
        "pairing_failed",
        "not_found",
        "confirm_required",
        "agent_blocked",
        "agent_not_ready",
        "approval_not_found",
        "approval_expired",
        "approval_nonce_mismatch",
        "approval_already_resolved",
        "rate_limited",
        "herdr_unavailable",
        "not_implemented",
        "too_large",
        "checksum_mismatch",
        "draft_changed",
        "draft_not_cleared",
        "terminals_disabled",
        "terminal_locked",
        "terminal_key_missing",
        "internal",
        "unrecognized"
      ],
      "type": "string"
    },
    "Event": {
      "oneOf": [
        {
          "properties": {
            "agent": {
              "$ref": "#/$defs/Agent"
            },
            "name": {
              "const": "agent.status",
              "type": "string"
            }
          },
          "required": [
            "name",
            "agent"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TerminalRead",
          "properties": {
            "name": {
              "const": "agent.output",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/OutputPatch",
          "properties": {
            "name": {
              "const": "agent.output_patch",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approval": {
              "$ref": "#/$defs/Approval"
            },
            "name": {
              "const": "approval.needed",
              "type": "string"
            }
          },
          "required": [
            "name",
            "approval"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approval_id": {
              "$ref": "#/$defs/ApprovalId"
            },
            "name": {
              "const": "approval.resolved",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/ApprovalOutcome"
            }
          },
          "required": [
            "name",
            "approval_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "flock.changed",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "plan.usage",
              "type": "string"
            },
            "plan_usage": {
              "$ref": "#/$defs/PlanUsage"
            }
          },
          "required": [
            "name",
            "plan_usage"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "const": "Unrecognized",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "Flock": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "type": "array"
        },
        "approvals": {
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "type": "array"
        },
        "machine": {
          "$ref": "#/$defs/MachineInfo"
        },
        "plan_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "The machine's plan usage, with or without a Claude Code agent open."
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "starred": {
          "description": "Starred panes, which collied follows across a herdr restart until they close.",
          "items": {
            "$ref": "#/$defs/TerminalId"
          },
          "type": "array"
        },
        "terminals": {
          "default": [],
          "description": "Shell panes: only when the machine enables terminals.",
          "items": {
            "$ref": "#/$defs/Terminal"
          },
          "type": "array"
        },
        "terminals_enabled": {
          "type": "boolean"
        },
        "workspaces": {
          "items": {
            "$ref": "#/$defs/Workspace"
          },
          "type": "array"
        }
      },
      "required": [
        "seq",
        "machine",
        "workspaces",
        "agents",
        "approvals"
      ],
      "type": "object"
    },
    "HelloResult": {
      "properties": {
        "collied_version": {
          "type": "string"
        },
        "herdr_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "$ref": "#/$defs/MachineInfo"
        },
        "paired": {
          "type": "boolean"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "collied_version",
        "machine",
        "paired"
      ],
      "type": "object"
    },
    "MachineInfo": {
      "description": "`node_id` is the Tailscale stable node ID; the phone pins it at pairing time.",
      "properties": {
        "herdr_session": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "node_id",
        "herdr_session"
      ],
      "type": "object"
    },
    "Nonce": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "OutputPatch": {
      "description": "The watched agent's new `recent` text: `head`, then lines `skip..skip + keep` of the\ntext the watch sent last, then `tail`, joined with `\\n`. `base` is [`text_hash`] of\nthat previous text. A client that does not hold it re-issues `agent.watch`, whose\nfirst event is always a full `agent.output`.",
      "properties": {
        "base": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "head": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keep": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skip": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "splits": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tail": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "truncated": {
          "type": "boolean"
        },
        "wraps": {
          "description": "[`TerminalRead::wraps`] and [`TerminalRead::splits`] of the new text, absent when\nthey are those of the previous text.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "terminal_id",
        "base",
        "head",
        "skip",
        "keep",
        "tail",
        "truncated"
      ],
      "type": "object"
    },
    "PendingTool": {
      "properties": {
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "type": "object"
    },
    "PlanUsage": {
      "description": "From Claude Code's status line input, as `collied statusline` last recorded it.",
      "properties": {
        "five_hour": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seven_day": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "recorded_ms"
      ],
      "type": "object"
    },
    "ReadSource": {
      "enum": [
        "visible",
        "recent"
      ],
      "type": "string"
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloResult",
          "properties": {
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "machine": {
              "$ref": "#/$defs/MachineInfo"
            },
            "type": {
              "const": "paired",
              "type": "string"
            }
          },
          "required": [
            "type",
            "machine"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Flock",
          "properties": {
            "type": {
              "const": "flock",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "workspaces",
              "type": "string"
            },
            "workspaces": {
              "items": {
                "$ref": "#/$defs/Workspace"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "workspaces"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TerminalRead",
          "properties": {
            "type": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TaskOptions",
          "properties": {
            "type": {
              "const": "task_options",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "terminal_id": {
              "$ref": "#/$defs/TerminalId"
            },
            "type": {
              "const": "task_started",
              "type": "string"
            },
            "workspace_id": {
              "$ref": "#/$defs/WorkspaceId"
            }
          },
          "required": [
            "type",
            "workspace_id",
            "terminal_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approvals": {
              "items": {
                "$ref": "#/$defs/Approval"
              },
              "type": "array"
            },
            "type": {
              "const": "approvals",
              "type": "string"
            }
          },
          "required": [
            "type",
            "approvals"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approval_id": {
              "$ref": "#/$defs/ApprovalId"
            },
            "outcome": {
              "$ref": "#/$defs/ApprovalOutcome"
            },
            "type": {
              "const": "approval_resolved",
              "type": "string"
            }
          },
          "required": [
            "type",
            "approval_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "attachment_started",
              "type": "string"
            },
            "upload_id": {
              "$ref": "#/$defs/UploadId"
            }
          },
          "required": [
            "type",
            "upload_id"
          ],
          "type": "object"
        },
        {
          "description": "Absolute path of the stored file on the Mac.",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "attachment_stored",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "`None` when there is no input box to read: not a Claude Code agent, or a dialog.",
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "draft",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "challenge": {
              "$ref": "#/$defs/Nonce"
            },
            "terminal_id": {
              "$ref": "#/$defs/TerminalId"
            },
            "ttl_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "terminal_challenge",
              "type": "string"
            }
          },
          "required": [
            "type",
            "terminal_id",
            "challenge",
            "ttl_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "terminal_id": {
              "$ref": "#/$defs/TerminalId"
            },
            "ttl_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "terminal_granted",
              "type": "string"
            }
          },
          "required": [
            "type",
            "terminal_id",
            "ttl_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "ok",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "TaskOptions": {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentKind"
          },
          "type": "array"
        },
        "default_agent": {
          "$ref": "#/$defs/AgentKind"
        },
        "recent_cwds": {
          "items": {
            "$ref": "#/$defs/Cwd"
          },
          "type": "array"
        }
      },
