{
  "$defs": {
    "ActivityId": {
      "pattern": "^[A-Za-z0-9-]{1,64}$",
      "type": "string"
    },
    "AgentKind": {
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "type": "string"
    },
    "AgentPromptParams": {
      "additionalProperties": false,
      "description": "For a Claude Code agent, collied replaces an unsent draft in the Mac's input box only\nwhen it equals `expected_draft`; any other draft fails with `draft_changed`.",
      "properties": {
        "expected_draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftText"
            },
            {
              "type": "null"
            }
          ]
        },
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "text": {
          "$ref": "#/$defs/PromptText"
        }
      },
      "required": [
        "op_id",
        "terminal_id",
        "text"
      ],
      "type": "object"
    },
    "AgentSendKeysParams": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "$ref": "#/$defs/Key"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        }
      },
      "required": [
        "op_id",
        "terminal_id",
        "keys"
      ],
      "type": "object"
    },
    "AgentTarget": {
      "additionalProperties": false,
      "properties": {
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        }
      },
      "required": [
        "terminal_id"
      ],
      "type": "object"
    },
    "AgentTypeTextParams": {
      "additionalProperties": false,
      "description": "Typed into the free-text field of a blocked Claude Code question or plan, then Enter.\nOne line: Enter is what submits it.",
      "properties": {
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "text": {
          "$ref": "#/$defs/PromptText"
        }
      },
      "required": [
        "op_id",
        "terminal_id",
        "text"
      ],
      "type": "object"
    },
    "AgentWatchParams": {
      "additionalProperties": false,
      "description": "One watched agent per connection; `None` stops `agent.output` events.",
      "properties": {
        "terminal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ApnsEnvironment": {
      "enum": [
        "sandbox",
        "production"
      ],
      "type": "string"
    },
    "ApprovalDecideParams": {
      "additionalProperties": false,
      "description": "`choice` is set exactly when `decision` is `choose`. `note`, one line of at most 200\ncharacters, goes with `approve` or `deny` on an approval with `supports_note`: collied\ntypes it into the option's amend field before Enter.",
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "choice": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "nonce": {
          "$ref": "#/$defs/Nonce"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "approval_id",
        "decision",
        "nonce"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "AttachmentAbortParams": {
      "additionalProperties": false,
      "properties": {
        "upload_id": {
          "$ref": "#/$defs/UploadId"
        }
      },
      "required": [
        "upload_id"
      ],
      "type": "object"
    },
    "AttachmentBeginParams": {
      "additionalProperties": false,
      "description": "`sha256` covers the whole file; collied checks it and the size before keeping it.",
      "properties": {
        "name": {
          "$ref": "#/$defs/AttachmentName"
        },
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "size": {
          "format": "uint64",
          "maximum": 20971520,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "op_id",
        "name",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "AttachmentChunkParams": {
      "additionalProperties": false,
      "description": "Chunks arrive in order: `offset` is the number of bytes already received.",
      "properties": {
        "data": {
          "$ref": "#/$defs/ChunkData"
        },
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "upload_id": {
          "$ref": "#/$defs/UploadId"
        }
      },
      "required": [
        "upload_id",
        "offset",
        "data"
      ],
      "type": "object"
    },
    "AttachmentCommitParams": {
      "additionalProperties": false,
      "properties": {
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "upload_id": {
          "$ref": "#/$defs/UploadId"
        }
      },
      "required": [
        "op_id",
        "upload_id"
      ],
      "type": "object"
    },
    "AttachmentName": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "ChunkData": {
      "maxLength": 43692,
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "type": "string"
    },
    "Cwd": {
      "maxLength": 1024,
      "pattern": "^/",
      "type": "string"
    },
    "Decision": {
      "oneOf": [
        {
          "enum": [
            "approve",
            "approve_always",
            "deny"
          ],
          "type": "string"
        },
        {
          "const": "choose",
          "description": "Pick `Approval.choices[choice]`; only on an approval that offers no other decision.",
          "type": "string"
        }
      ]
    },
    "DraftText": {
      "maxLength": 32768,
      "type": "string"
    },
    "Empty": {
      "additionalProperties": false,
      "type": "object"
    },
    "HelloParams": {
      "additionalProperties": false,
      "properties": {
        "app_version": {
          "$ref": "#/$defs/Label"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "app_version"
      ],
      "type": "object"
    },
    "Key": {
      "enum": [
        "enter",
        "esc",
        "up",
        "down",
        "left",
        "right",
        "tab",
        "shift+tab",
        "ctrl+c",
        "y",
        "n"
      ],
      "type": "string"
    },
    "Label": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "Nonce": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "NotificationKey": {
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "type": "string"
    },
    "OpId": {
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "type": "string"
    },
    "PairCompleteParams": {
      "additionalProperties": false,
      "properties": {
        "device_label": {
          "$ref": "#/$defs/Label"
        },
        "pairing_code": {
          "$ref": "#/$defs/PairingCode"
        }
      },
      "required": [
        "pairing_code",
        "device_label"
      ],
      "type": "object"
    },
    "PairingCode": {
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "type": "string"
    },
    "PaneCloseParams": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "default": false,
          "type": "boolean"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        }
      },
      "required": [
        "terminal_id"
      ],
      "type": "object"
    },
    "PromptText": {
      "maxLength": 32768,
      "minLength": 1,
      "type": "string"
    },
    "PushActivityEndParams": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "$ref": "#/$defs/ActivityId"
        }
      },
      "required": [
        "activity_id"
      ],
      "type": "object"
    },
    "PushActivityTokenParams": {
      "additionalProperties": false,
      "description": "A Live Activity's update token. collied pushes the followed terminal's status to it,\nin the APNs environment of the device's own `push.register`.",
      "properties": {
        "activity_id": {
          "$ref": "#/$defs/ActivityId"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        },
        "token": {
          "$ref": "#/$defs/PushToken"
        }
      },
      "required": [
        "activity_id",
        "terminal_id",
        "token"
      ],
      "type": "object"
    },
    "PushRegisterParams": {
      "additionalProperties": false,
      "properties": {
        "apns_token": {
          "$ref": "#/$defs/PushToken"
        },
        "environment": {
          "$ref": "#/$defs/ApnsEnvironment"
        },
        "live_activity_push_to_start_token": {
          "anyOf": [
            {
              "$ref": "#/$defs/PushToken"
            },
            {
              "type": "null"
            }
          ]
        },
        "notification_key": {
          "$ref": "#/$defs/NotificationKey"
        }
      },
      "required": [
        "apns_token",
        "environment",
        "notification_key"
      ],
      "type": "object"
    },
    "PushToken": {
      "pattern": "^[0-9A-Fa-f]{64,256}$",
      "type": "string"
    },
    "ReadParams": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ReadSource"
        },
        "terminal_id": {
          "$ref": "#/$defs/TerminalId"
        }
      },
      "required": [
        "terminal_id",
        "source"
      ],
      "type": "object"
    },
    "ReadSource": {
      "enum": [
        "visible",
        "recent"
      ],
      "type": "string"
    },
    "Sha256Hex": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "TaskNewParams": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentKind"
        },
        "cwd": {
          "$ref": "#/$defs/Cwd"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "op_id": {
          "$ref": "#/$defs/OpId"
        },
        "prompt": {
          "$ref": "#/$defs/PromptText"
        }
      },
      "required": [
        "op_id",
        "cwd",
        "agent",
        "prompt"
      ],
      "type": "object"
    },
    "TerminalId": {
      "pattern": "^[A-Za-z0-9_:.-]{1,64}$",
      "type": "string"
    },
    "UploadId": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "WorkspaceCloseParams": {
      "additionalProperties": false,
      "description": "`confirm` must be `true`; anything else yields `confirm_required`.",
      "properties": {
        "confirm": {
          "default": false,
          "type": "boolean"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "pattern": "^[A-Za-z0-9_:.-]{1,64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "method": {
          "const": "hello",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HelloParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "pair.complete",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PairCompleteParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "flock.snapshot",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Empty"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "workspace.list",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Empty"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.read",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ReadParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "pane.read",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ReadParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.watch",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentWatchParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "task.options",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Empty"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.draft",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentTarget"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.prompt",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentPromptParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.send_keys",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentSendKeysParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.type_text",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentTypeTextParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "agent.focus",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AgentTarget"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "task.new",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/TaskNewParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "workspace.close",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/WorkspaceCloseParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "pane.close",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PaneCloseParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "approval.list",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Empty"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "approval.decide",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ApprovalDecideParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "push.register",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PushRegisterParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "push.activity_token",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PushActivityTokenParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "push.activity_end",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PushActivityEndParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "attachment.begin",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AttachmentBeginParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "attachment.chunk",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AttachmentChunkParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "attachment.commit",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AttachmentCommitParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "method": {
          "const": "attachment.abort",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AttachmentAbortParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "id": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id"
  ],
  "title": "ClientFrame",
  "type": "object"
}
